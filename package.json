{
  "name": "portfolio",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "build": "BUILD_ID=$(git rev-parse --short HEAD) cf build",
    "preview": "vite preview",
    "deploy": "bun run build && cf deploy --prebuilt --mode production",
    "deploy:staging": "BUILD_ID=$(git rev-parse --short HEAD) cf deploy --mode staging",
    "cf-typegen": "cf workers types",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tanstack/highlight": "^0.1.0",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-start": "^1.168.56",
    "clsx": "^2.1.1",
    "katex": "0.18.9",
    "lucide-react": "^1.47.0",
    "motion": "^12.43.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-use-measure": "^2.1.7",
    "tailwind-merge": "^3.7.0",
    "torph": "^0.1.3",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.sha-52b0dc0e9",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "cf": "^1.0.0-beta.12",
    "prettier": "^3.9.8",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vite-tsconfig-paths": "^5.1.4"
  }
